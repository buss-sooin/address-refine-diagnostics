<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.address.refine.diagnostics</groupId>
  <artifactId>address-refine-diagnostics</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>address-refine-diagnostics</name>
  <description>검색과 진단을 결합한 주소정제 솔루션</description>

  <!--
    아래 module 태그는 Maven이 정한 이름이라 바꿀 수 없다.
    문서와 대화에서는 이것을 "빌드 단위"라 부르고,
    "모듈"은 design/03-pipeline.md 0절의 파서·관문·합치기를 가리킨다.
  -->
  <modules>
    <module>db-gen</module>
    <module>refine-core</module>
    <module>refine-api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.address.refine.diagnostics</groupId>
        <artifactId>refine-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
